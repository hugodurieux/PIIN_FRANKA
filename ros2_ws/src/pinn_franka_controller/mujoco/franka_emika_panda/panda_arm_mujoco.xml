  <actuator>
    <!-- Single motor (direct-torque) actuator per joint, NOT a pair of
         position+motor actuators (that was tried and reverted: mujoco_ros2_control
         binds exactly one MuJoCo actuator per joint, matched via this
         joint="panda_jointN" target attribute, auto-preferring a position-type
         actuator when one exists, and rejects any OTHER declared
         command_interface that doesn't match the chosen actuator's type:
         "Effort command interface... is not supported with position or
         velocity actuator" when both were declared). Instead, both the
         'position' command_interface (panda_arm_controller / MoveIt2's default
         execution) and 'effort' command_interface (panda_effort_controller /
         pinn_controller_node's Stage 3 path) are backed by this SAME motor
         actuator: 'effort' writes torque directly with no conversion; 'position'
         goes through mujoco_ros2_control's own internal PID (see
         config/mujoco_pid.yaml, referenced via the pids_config_file hardware
         param in panda_mujoco.ros2_control.xacro), which converts a position
         target into torque on this actuator, the same pattern
         mujoco_ros2_control_demos' Tutorial 3 (PID control) uses.
         ctrlrange matches network/constants.TORQUE_LIMITS
         ([87,87,87,87,12,12,12] Nm) as a hard safety clamp at the MuJoCo level,
         independent of pinn_controller_node's own clip to the same limits. -->
    <motor name="panda_joint1_torque" joint="panda_joint1" gear="1" ctrlrange="-87 87"/>
    <motor name="panda_joint2_torque" joint="panda_joint2" gear="1" ctrlrange="-87 87"/>
    <motor name="panda_joint3_torque" joint="panda_joint3" gear="1" ctrlrange="-87 87"/>
    <motor name="panda_joint4_torque" joint="panda_joint4" gear="1" ctrlrange="-87 87"/>
    <motor name="panda_joint5_torque" joint="panda_joint5" gear="1" ctrlrange="-12 12"/>
    <motor name="panda_joint6_torque" joint="panda_joint6" gear="1" ctrlrange="-12 12"/>
    <motor name="panda_joint7_torque" joint="panda_joint7" gear="1" ctrlrange="-12 12"/>

    <!-- 2026-07-22: gripper actuator. A native <position> type (not <motor>, unlike the arm)
         since panda_finger_joint1 only ever exports a 'position' command_interface (see
         panda_mujoco.ros2_control.xacro) with no pids_config_file entry — matching
         write()'s is_position_control_enabled branch (raw ctrl passthrough, no PID needed),
         which is exactly a native MuJoCo <position> actuator's own ctrl semantics (ctrl IS
         the position setpoint). forcerange matches the URDF's own
         <limit effort="20".../> on panda_finger_joint1.

         2026-07-22 correction: kp=500 (this comment's own prior value) with no explicit kv
         was confirmed live to be badly underdamped for this 15g finger. The joint's passive
         damping="1" is inherited from the "panda" default class (sized for the arm's much
         heavier links), not for a 15g mass — critical damping at kp=500 would need
         c=2*sqrt(500*0.015)=~5.5, an order of magnitude more than the 1 it actually has.
         Result observed live: commanding either open (0.04) or close (0.0) produced heavy
         oscillation that overshot the joint's own 0-0.04 range by ~14mm in both directions,
         which position_controllers/GripperActionController (confirmed by reading
         gripper_action_controller_impl.hpp from ros2_controllers' jazzy branch: its result
         position comes straight from the position state_interface, i.e. real qpos, not a
         derived value) sampled mid-oscillation and reported as a stalled, out-of-range,
         reached_goal=false result for both directions. Fixed by both lowering kp and adding
         an explicit kv: critical damping at kp=30 needs c=2*sqrt(30*0.015)=~1.34; kv=3 (on
         top of the existing passive damping=1) gives a total of 4, comfortably overdamped
         for a smooth, non-oscillatory first working version. Revisit if grasping needs
         faster closing than this produces. panda_finger_joint2 has no actuator of its own —
         see the <equality> constraint below. -->
    <position name="panda_finger_joint1_position" joint="panda_finger_joint1" kp="30" kv="3" ctrlrange="0 0.04" forcerange="-20 20"/>
  </actuator>

  <equality>
    <!-- Keeps panda_finger_joint2 mechanically synced to panda_finger_joint1 in physics,
         since only joint1 has a ros2_control command_interface (see actuator comment above
         and panda_mujoco.ros2_control.xacro). Solver params as-is from mujoco_menagerie. -->
    <joint joint1="panda_finger_joint1" joint2="panda_finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <contact>
    <!-- Upstream only excluded link0/link1. The other adjacent pairs share a
         joint with collision meshes that touch/nearly-touch by design, same
         as config/panda.srdf's disable_collisions "Adjacent" list (a
         MoveIt2-planning-only exclude list, not read by MuJoCo, this is
         the physics-level equivalent). Missing these produced a small,
         constant, fast-buzz vibration in the arm at rest: flickering contact
         forces between links that were never meant to register as real
         collisions. -->
    <exclude body1="link0" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="link7"/>
  </contact>

